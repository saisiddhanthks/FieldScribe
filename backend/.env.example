# Copy this file to ".env" (same folder) and paste your keys. Never share .env or commit it.
# Only one key is needed. Providers are tried in FIELDSCRIBE_AGENT_ORDER; the offline engine is always the last resort.

# 1) Google Gemini (free tier) - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# 2) Groq (free tier, very fast) - get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3) OpenAI (paid, separate from ChatGPT subscriptions) - optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4) Ollama - fully offline local model (install from https://ollama.com, then: ollama pull qwen2.5:7b)
OLLAMA_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:3b   (the installer picks one for this laptop; change it in Settings -> Offline AI)

FIELDSCRIBE_AGENT_ORDER=gemini,groq,openai,ollama,offline

# --- Security ---------------------------------------------------------------
# PIN login is on by default (demo PINs: crew 1080, ED 2020, supervisor 9090). 0 = off (development only)
FIELDSCRIBE_AUTH=1
# The device database encryption key is generated automatically on first start and appended below.

# --- ED / state hub (optional) ----------------------------------------------
# Real PostgreSQL hub that ambulances sync to. Leave empty to use the built-in simulated hub.
# FIELDSCRIBE_HUB_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fieldscribe_hub
